{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "composer-media-studio",
  "account_id": "1003dc1d93af0ebea56b2f1252f89627",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "media.loftwah.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "media-studio",
      "database_id": "c3451e4b-48b7-44cd-bf0e-7d953f763df2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "media-studio"
    },
    {
      // Darkroom keeps each operation's retained bytes here, under media-output/.
      // Same bucket as MEDIA, so nothing new to create.
      "binding": "APP_ARTIFACTS",
      "bucket_name": "media-studio"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MEDIA_OPERATION", "class_name": "MediaOperationDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MediaOperationDO"] }],
  "ai": {
    "binding": "AI"
  },
  // Darkroom fits reference images read from MEDIA to the selected model.
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://media.loftwah.com",
    // Signed render inputs are fetched by the render provider, not a browser.
    // The workers.dev hostname avoids edge bot/access rules on the custom
    // domain while staying the same Worker and signature check.
    "RENDER_ORIGIN": "https://composer-media-studio.loftwah.workers.dev",
    "COMPOSER_ORIGIN": "https://composer.loftwah.com",
    "MONTHLY_ALLOWANCE_MICRO": "5000000",
    "PUBLIC_BUILD_URL": "https://composer.loftwah.com/init?start=media-studio",
    "PUBLIC_STORY_URL": "https://composer.loftwah.com/media-studio",
    "WOODHOUSE_SHARE": "true",
    "PUBLIC_SHOWCASE_SLUGS": "Na9FNUB_VhzZ7zA9,hvhyL90Wm1EXbrAE,WWMS3shJ_pGapR_i,jWri1dDSfWbZ8HXD,QXaKw_fL9cZenKCg,XrgIiuDDt6prdjGV,uInuEzJuaHUW4TjM,1qjHzSyIrIAQ4Zuk,gkjDvBg5eqMO6BBz,VQDLALCKpgZoylDr,5ycQgw8F4AhOj_oB,zCUxlr5AhN_K_ZJx,i0q2jGofhv2yu6m2,HzpgDbn3CC1WcTE6,Z7_WEb7Tpt68x_cW,HgHEHK2VIycsc58l,uARd0tT8kV-ASZPH,6VibHIWuuQgPd9oM,eW6oUa6GbqJCnuFN,h1zmUXhF0hEzm-g9,KKxqXp1_5Po84FMU",
    "LAUNCH_KIT_URL": "https://composer-launch-kit.loftwah.workers.dev/"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "preview_urls": false
}
