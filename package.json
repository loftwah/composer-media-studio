{
  "name": "@loftwah/composer-media-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.19.0",
  "scripts": {
    "dev": "pnpm build:frontend && wrangler dev --local --persist-to .wrangler/state",
    "build:frontend": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && node scripts/launcher-assets.mjs --check && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "migrate:local": "wrangler d1 migrations apply media-studio --local",
    "migrate:remote": "wrangler d1 migrations apply media-studio --remote"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=22.23.5 <23 || >=24.22.3 <25 || >=26.13.1 <27"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
